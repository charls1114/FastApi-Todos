    {
      "id": 9,
      "type": "table",
      "title": "요청별 요약",
      "description": "평균(ms)은 5초 구간 평균들의 평균이므로 근사값",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "query": "SELECT sum(\"count\") AS \"요청 수\", mean(\"avg\") AS \"평균(ms)\", max(\"pct95.0\") AS \"p95 최대(ms)\", max(\"max\") AS \"최대(ms)\" FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" =~ /^$transaction$/ AND \"statut\" = 'all' AND $timeFilter GROUP BY \"transaction\"",
          "resultFormat": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "query": "SELECT sum(\"count\") AS \"에러 수\" FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" =~ /^$transaction$/ AND \"statut\" = 'ko' AND $timeFilter GROUP BY \"transaction\"",
          "resultFormat": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
