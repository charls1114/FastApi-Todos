            "version": "13.2.4",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "decimals": 2,
                  "noValue": "요청 없음",
