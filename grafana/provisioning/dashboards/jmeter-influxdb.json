    {
      "id": 8,
      "type": "timeseries",
      "title": "요청별 평균 응답시간",
      "description": "Sampler(요청) 이름별 평균 응답시간. 위쪽 '요청' 변수로 골라 볼 수 있다",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "query": "SELECT mean(\"avg\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" =~ /^$transaction$/ AND \"statut\" = 'all' AND $timeFilter GROUP BY time($__interval), \"transaction\" fill(null)",
          "resultFormat": "time_series",
          "alias": "$tag_transaction"
