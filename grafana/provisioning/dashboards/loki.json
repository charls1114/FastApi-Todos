                      "spec": {
                        "direction": "backward",
                        "editorMode": "code",
                        "expr": "(sum(count_over_time({application=\"fastapi\"} | pattern `<client> - \"<method> <path> <_>\" <status> <duration>s` | status=~\"[1-5][0-9][0-9]\" | path!=\"/metrics\" | status=~\"5..\" [5m])) or vector(0)) / sum(count_over_time({application=\"fastapi\"} | pattern `<client> - \"<method> <path> <_>\" <status> <duration>s` | status=~\"[1-5][0-9][0-9]\" | path!=\"/metrics\" [5m])) * 100",
                        "queryType": "instant"
                      }
