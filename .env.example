POSTGRES_DB=todos
POSTGRES_USER=todos
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
# 로그인 토큰(JWT) 서명 키. 32자 이상의 임의 값으로 바꿉니다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=60
# 같은 계정에서 비밀번호를 연속으로 LOGIN_MAX_ATTEMPTS 번 틀리면 LOGIN_LOCK_MINUTES 분 동안 로그인을 막습니다.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
