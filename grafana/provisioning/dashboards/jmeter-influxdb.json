          "rawQuery": true,
          "query": "SELECT max(\"pct95.0\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" = 'all' AND \"statut\" = 'all' AND $timeFilter",
          "resultFormat": "time_series"
