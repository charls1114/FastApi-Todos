{
  "uid": "jmeter-influxdb",
  "title": "JMeter 부하 테스트 (InfluxDB)",
  "description": "JMeter Backend Listener 가 InfluxDB 로 보낸 실시간 부하 테스트 결과",
  "tags": [
    "jmeter",
    "influxdb",
    "load-test"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "실행(application)",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-jmeter"
        },
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"application\"",
        "definition": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"application\"",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "transaction",
        "label": "요청",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-jmeter"
        },
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"transaction\" WHERE \"application\" =~ /^$application$/",
        "definition": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"transaction\" WHERE \"application\" =~ /^$application$/",
        "regex": "/^(?!all$|internal$).*/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "테스트 시작/종료",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-jmeter"
        },
        "enable": true,
        "iconColor": "purple",
        "query": "SELECT \"text\" FROM \"events\" WHERE \"application\" =~ /^$application$/ AND $timeFilter",
        "textColumn": "text",
        "tagsColumn": "title"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "총 요청 수",
      "description": "선택한 시간 범위 동안 보낸 전체 요청 수",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "query": "SELECT sum(\"count\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" = 'all' AND \"statut\" = 'all' AND $timeFilter",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "에러율",
      "description": "실패한 요청 / 전체 요청 (Assertion 실패 포함)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-jmeter"
          },
          "rawQuery": true,
          "query": "SELECT sum(\"countError\") / sum(\"count\") * 100 FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" = 'all' AND \"statut\" = 'all' AND $timeFilter",
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "평균 처리량",
      "description": "초당 처리한 요청 수 평균 (JMeter 가 5초마다 보내는 요청 수 ÷ 5)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-jmeter"
